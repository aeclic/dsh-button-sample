{
  "name": "dsh-button-sample",
  "version": "0.1.0",
  "description": "One sample bundle for the DSH desktop GUI: restart/quit power controls (floating button and sidebar icon) plus a ChatGPT-style Continue button that resumes a turn cut off by max-tokens, by Stop, or by a provider failure.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "restart",
    "quit",
    "power-menu",
    "continue",
    "continue-generating",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aeclic/dsh-button-sample.git"
  },
  "homepage": "https://github.com/aeclic/dsh-button-sample#readme",
  "bugs": {
    "url": "https://github.com/aeclic/dsh-button-sample/issues"
  },
  "forkedFrom": "https://github.com/WhichWitchWin/dsh-power-button",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/run.cjs"
  },
  "os": [
    "win32"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "docs",
    "LICENSE",
    "icon.svg",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
